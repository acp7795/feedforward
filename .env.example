# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/videogamedb

# Encryption Key (Base64-encoded 32-byte key)
# Generate with: openssl rand -base64 32
# Or: python3 -c "import base64; import os; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=your-base64-encoded-32-byte-encryption-key-here

# Cookie Security (set to true in production)
COOKIE_SECURE=false

# Optional: Session Secret (if needed)
SESSION_SECRET=your-session-secret-here

# Application Port (optional, default is 8080)
# SERVER_PORT=8080
